# ============================================================
#  Copia este archivo a .env  ->  cp .env.example .env
#  Nunca subas .env al repositorio (ya está en .gitignore).
# ============================================================

# --- Servidor -------------------------------------------------
HOST=0.0.0.0
PORT=8080

# Token que la APK debe enviar como "Authorization: Bearer ...".
# Déjalo vacío solo para pruebas en localhost.
ROUTER_TOKEN=cambia-este-token

# Token para /admin/*. Si lo dejas vacío, /admin solo responde a localhost.
ADMIN_TOKEN=cambia-este-token-admin

# Máximo de intentos (proveedor/clave distintos) por petición.
MAX_ATTEMPTS=8

# Timeout de lectura por proveedor (segundos).
PROVIDER_TIMEOUT=90

# Tiempo máximo total de una petición (incluye reintentos).
REQUEST_TIMEOUT=240

# Rutas de configuración y estado (opcional).
# CONFIG_PATH=config/providers.json
# STATE_PATH=data/state.json

# Guarda en disco las claves añadidas en caliente y los cooldowns.
PERSIST_KEYS=true

# CORS abierto (útil para WebView / navegador de pruebas).
ALLOW_CORS=true

# ============================================================
#  CLAVES DE PROVEEDORES
#  Puedes poner varias claves separadas por comas o usar
#  el sufijo _2, _3 ... (GROQ_API_KEY, GROQ_API_KEY_2, ...)
# ============================================================

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# GitHub Models — https://github.com/settings/tokens (scope: models:read)
GITHUB_MODELS_TOKEN=

# SambaNova — https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cloudflare Workers AI — token + account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Together — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
HF_TOKEN=

# Z.ai / Zhipu GLM (glm-4.5-flash gratis) — https://z.ai/manage-apikey/apikey-list
ZHIPU_API_KEY=

# Alibaba DashScope (Qwen, cuota gratis inicial)
DASHSCOPE_API_KEY=

# --- Locales (sin clave) -------------------------------------
# Ollama en el mismo dispositivo: http://127.0.0.1:11434/v1
# Actívalo en config/providers.json -> "enabled": true
