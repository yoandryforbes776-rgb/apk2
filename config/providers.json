        "GEMINI_API_KEY",
        "GOOGLE_API_KEY"
      ],
      "defaultModel": "gemini-2.5-flash",
      "models": [
        "gemini-2.5-flash",
        "gemini-2.5-flash-lite",
        "gemini-2.5-pro",
        "gemini-2.0-flash"
